
# =============================================================================
# Cohort Connect backend environment variables (example only; no real secrets)
# =============================================================================
# Copy this file to `.env` in the backend directory and fill in real values locally.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GEMINI_API_KEY=your_gemini_api_key
# Optional: raise if large classes truncate Gemini output (default 8192)
# GEMINI_MAX_OUTPUT_TOKENS=8192


